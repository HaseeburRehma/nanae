# ============================================================
#  Nanae Reinigungsservice — Environment variables
#  Copy this file to .env.local and fill the values.
#  Never commit .env.local — it is already gitignored.
# ============================================================

# ---- Gmail SMTP for the contact form ----
# 1. Sign in to https://myaccount.google.com/ with info@nanae.de
# 2. Enable 2-Step Verification (required for App Passwords)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Generate a new app password (16 characters, no spaces)
# 5. Paste the values below.

SMTP_USER=info@nanae.de
SMTP_PASS=eaegociekullxhrx  # 16-char Gmail app password (no spaces)

# Where the contact form should deliver messages (defaults to SMTP_USER)
CONTACT_TO=info@nanae.de

# Optional — the "From" header. Keep equal to SMTP_USER for Gmail.
CONTACT_FROM=info@nanae.de


# ---- Instagram Graph API (auto-update of the Reels strip) ----
# When IG_ACCESS_TOKEN + IG_USER_ID are set, /api/ig-reels pulls the
# latest 6 reels from @nanae_service every hour. New reels you post on
# Instagram appear on the website automatically (no code redeploy).
# If unset, the website keeps showing the hard-coded fallback list.
#
# How to obtain the values (one-time setup, ~10 min):
#   1. Convert @nanae_service to a Business/Creator account (Profile →
#      Settings → For professionals → Account type).
#   2. Open https://developers.facebook.com → My Apps → Create App
#      (type: "Business"). Add the "Instagram Graph API" product.
#   3. Connect the Instagram account to a Facebook Page (any page works).
#   4. Use the Graph API Explorer to fetch a long-lived user access token
#      (Tools → Graph API Explorer → Generate Token, request scopes:
#      instagram_basic, pages_show_list, pages_read_engagement).
#   5. Exchange the short-lived token for a 60-day long-lived token via
#      /oauth/access_token?grant_type=ig_exchange_token …
#   6. Fetch the IG User ID: GET /me/accounts → pick the page →
#      GET /{page-id}?fields=instagram_business_account
#
# Tokens are 60-day long-lived — refresh once a month via Cron / manually.

IG_ACCESS_TOKEN=
IG_USER_ID=
